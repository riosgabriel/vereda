1 226.3 729.8 225.5 732.8 224.7 C735.7 223.9 739 223.1 742.4 222.3 C745.8 221.4 749.5 220.6 753.3 219.8 C757.1 219 761.1 218.2 765.3 217.4 C769.4 216.6 773.8 215.8 778.2 215 C782.6 214.2 787.2 213.4 791.8 212.6 C796.4 211.8 801.1 211 805.9 210.2 C810.6 209.4 815.4 208.6 820.2 207.8 C825 206.9 829.9 206.1 834.6 205.3 C839.4 204.5 844.2 203.7 848.9 202.9 C853.6 202.1 858.3 201.3 862.8 200.5 C867.4 199.7 871.9 198.9 876.3 198.1 C880.6 197.3 884.9 196.5 889 195.7 C893.1 194.9 897.1 194.1 900.9 193.3 C904.8 192.4 908.5 191.6 912 190.8 C915.4 190 918.8 189.2 921.9 188.4 C925.1 187.6 928 186.8 930.8 186 C933.5 185.2 936.1 184.4 938.5 183.6 C940.8 182.8 943 182 944.9 181.2 C946.9 180.4 948.7 179.6 950.2 178.8 C951.8 177.9 953.1 177.1 954.3 176.3 C955.4 175.5 956.4 174.7 957.2 173.9 C958 173.1 958.5 172.3 959 171.5 C959.4 170.7 959.6 169.9 959.7 169.1 C959.8 168.3 959.7 167.5 959.5 166.7 C959.3 165.9 959 165.1 958.5 164.3 C958 163.4 957.4 162.6 956.7 161.8 C956.1 161 955.3 160.2 954.4 159.4 C953.5 158.6 952.6 157.8 951.6 157 C950.6 156.2 949.6 155.4 948.5 154.6 C947.4 153.8 946.3 153 945.2 152.2 C944.1 151.4 943 150.6 941.9 149.8 C940.8 148.9 939.7 148.1 938.7 147.3 C937.7 146.5 936.7 145.7 935.7 144.9 C934.8 144.1 933.9 143.3 933.1 142.5 C932.3 141.7 931.6 140.9 931 140.1 C930.4 139.3 929.9 138.5 929.5 137.7 C929.1 136.9 928.8 136.1 928.6 135.3 C928.4 134.4 928.4 133.6 928.5 132.8 C928.6 132 928.8 131.2 929.2 130.4 C929.6 129.6 930.5 128.4 930.8 128 Z";
---

{
	variant === "line" && (
		<div class="horizon-line" aria-hidden="true">
			<svg viewBox="0 60 1440 184" preserveAspectRatio="xMidYMax meet">
				<defs>
					<linearGradient id="horizon-line-trail" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0.6" stop-color="currentColor" stop-opacity="0.55" />
						<stop offset="1" stop-color="currentColor" stop-opacity="0" />
					</linearGradient>
				</defs>
				<circle class="sun" cx="930" cy="104" r="34" />
				<path class="hill" d={`${FAR} ${BASE}`} />
				<path class="ridge far" d={FAR} />
				<path class="hill" d={`${MID} ${BASE}`} />
				<path class="ridge" d={MID} />
				<path class="hill" d={`${FRONT} ${BASE}`} />
				<path class="ridge near" d={FRONT} />
				<path class="path" d={TRAIL} fill="url(#horizon-line-trail)" />
			</svg>
		</div>
	)
}
{variant === "painted" && (
<div class="horizon" aria-hidden="true">
	<svg viewBox="0 0 1440 240" preserveAspectRatio="xMidYMax slice">
		<defs>
			<radialGradient id="horizon-glow">
				<stop offset="0" stop-color="#f37d18" stop-opacity="0.45"></stop>
				<stop offset="1" stop-color="#f37d18" stop-opacity="0"></stop>
			</radialGradient>
			<radialGradient id="horizon-sun">
				<stop class="sun-core" offset="0"></stop>
				<stop offset="1" stop-color="#f37d18"></stop>
			</radialGradient>
			<radialGradient id="horizon-halo">
				<stop offset="0.4" stop-color="#ffcf5c" stop-opacity="0.6"></stop>
				<stop offset="1" stop-color="#ffcf5c" stop-opacity="0"></stop>
			</radialGradient>
			<linearGradient id="horizon-sky" x1="0" y1="0" x2="0" y2="1">
				<stop class="sky-high" offset="0"></stop>
				<stop class="sky-mid" offset="0.3"></stop>
				<stop class="sky-low" offset="0.55"></stop>
			</linearGradient>
			<linearGradient id="horizon-trail" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0.6" stop-color="#f7e7c7"></stop>
				<stop offset="0.965" stop-color="#f7e7c7" stop-opacity="0"></stop>
			</linearGradient>
		</defs>
		<rect class="sky" width="1440" height="240" fill="url(#horizon-sky)"></rect>
		<ellipse class="glow" cx="930" cy="116" rx="480" ry="110" fill="url(#horizon-glow)"></ellipse>
		<path class="haze" d="M0 66 C 320 50, 700 70, 930 126 C 1150 72, 1400 52, 1440 54 L1440 240 L0 240 Z"></path>
		<circle class="halo" cx="930" cy="104" r="80" fill="url(#horizon-halo)"></circle>
		<circle class="sun" cx="930" cy="104" r="34" fill="url(#horizon-sun)"></circle>
		<path
			class="far"
			d="M0 100 C 320 86, 690 94, 860 118 C 895 123, 918 127, 930 128 C 946 126, 985 116, 1080 106 C 1240 92, 1380 92, 1440 90 L1440 240 L0 240 Z"
		></path>
		<path class="mid" d="M0 158 C 260 124, 520 126, 760 148 C 860 157, 960 150, 1100 138 C 1260 124, 1380 128, 1440 132 L1440 240 L0 240 Z"
		></path>
		<path
			class="front"
			d="M0 214 C 300 198, 500 206, 640 226 C 700 236, 860 238, 1000 222 C 1150 206, 1320 208, 1440 214 L1440 240 L0 240 Z"
		></path>
		<path class="trail" d={TRAIL} fill="url(#horizon-trail)"></path>
	</svg>
</div>
)}

<style>
	.horizon {
		/* Full bleed out of the splash column. */
		margin-inline: calc(50% - 50vw);
		/* The art's own aspect (240/1440) so nothing is cropped up to 2400px wide; phones crop the
		   sides. Past the cap, `slice` crops the top of the sky. */
		height: clamp(130px, 16.7vw, 400px);
		margin-top: -1rem;
	}
	/* 100vw counts a classic scrollbar (Windows, most Linux) and 50% doesn't, so the full bleed
	   overshoots the page by half the scrollbar and the page scrolls sideways. The clip sits on
	   Starlight's content frame, not <html>: on the root, browsers turn clip into hidden, which
	   still scrolls. */
	:global(.main-frame:has(.horizon)) {
		overflow-x: clip;
	}
	svg {
		display: block;
		width: 100%;
		height: 100%;
	}
	/* The sky, glow and haze reach the top of the art, and past the height cap the top is cropped
	   away. Fading the top of whatever is visible keeps that edge soft at any width; the daytime
	   sun's top sits below the fade. */
	.horizon svg {
		mask-image: linear-gradient(to bottom, transparent, #000 20%);
	}
	/* One number, --rise, places the whole painting between the logo's sunset (0) and full sun (1):
	   every colour and position below is a function of it. Dark theme is the main look, the logo's
	   valley: sun half-set in the notch under an orange sky. Light theme is the full sun, the whole
	   disc clear of the ridge. The hills keep the logo's greens in both. It is registered so the browser can tween it, so switching themes plays a
	   short sunrise or sunset. */
	@property --rise {
		syntax: "<number>";
		inherits: true;
		initial-value: 1;
	}
	:global(:root[data-theme="dark"]) .horizon {
		--rise: 0;
	}
	@media (prefers-reduced-motion: no-preference) {
		.horizon {
			transition: --rise 1.2s ease-in-out;
		}
	}
	/* Rust overhead and orange on the ridges at sunset, pale gold in full sun. The top stop is the mid
	   colour made transparent: SVG gradients blend colour and opacity separately, so a transparent
	   stop of any other colour tints the fade. */
	.sky-high,
	.sky-mid {
		stop-color: color-mix(in oklab, #fbe7c0 calc(var(--rise) * 100%), #8a3220);
	}
	.sky-high {
		stop-opacity: 0;
	}
	.sky-mid {
		stop-opacity: calc(0.7 - 0.55 * var(--rise));
	}
	.sky-low {
		stop-color: color-mix(in oklab, #f7d79a calc(var(--rise) * 100%), #ee7a2a);
		stop-opacity: calc(0.9 - 0.55 * var(--rise));
	}
	/* The same disc in both themes: half behind the notch at sunset, clear of the ridge in full sun.
	   In full sun it also burns hotter: a yellow core inside the orange rim, and a halo around it. */
	.horizon .sun,
	.horizon .halo {
		transform: translateY(calc(24px - 36px * var(--rise)));
	}
	.sun-core {
		stop-color: color-mix(in oklab, #ffc23d calc(var(--rise) * 100%), #f37d18);
	}
	.horizon .halo {
		opacity: var(--rise);
	}
	.horizon .glow {
		transform-box: fill-box;
		transform-origin: center;
		transform: translateY(calc(24px - 36px * var(--rise))) scale(calc(0.7 + 0.65 * var(--rise)));
		opacity: calc(0.6 + 0.4 * var(--rise));
	}
	.horizon .haze {
		fill: #dbab33;
		opacity: calc(0.15 + 0.13 * var(--rise));
	}
	.horizon .trail {
		opacity: calc(0.9 + 0.1 * var(--rise));
	}
	.horizon .far {
		fill: color-mix(in oklab, #48754f calc(var(--rise) * 100%), #3a5e40);
	}
	.horizon .mid {
		fill: color-mix(in oklab, #113b36 calc(var(--rise) * 100%), #0e322e);
	}
	.front {
		fill: var(--sl-color-black);
	}

	.horizon-line {
		margin-top: 3rem;
		color: var(--sl-color-accent);
	}
	.horizon-line svg {
		height: auto;
	}
	.horizon-line .sun {
		fill: var(--sl-color-accent);
		opacity: 0.35;
	}
	.hill {
		fill: var(--sl-color-bg);
	}
	.ridge {
		fill: none;
		stroke: var(--sl-color-gray-5);
		stroke-width: 1.5;
		vector-effect: non-scaling-stroke;
	}
	.ridge.far {
		stroke: var(--sl-color-gray-6);
	}
	.ridge.near {
		stroke: var(--sl-color-gray-4);
	}
</style>
