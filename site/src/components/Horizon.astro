---
// The logo's valley as a horizon between the landing page's hero and its first section: a sun
// sitting in the notch of a V-shaped valley, and the cream path (the "vereda") winding from the
// viewer up to it. The front hill is filled with the page background, so the painting dissolves
// into the content below it.
//
// The trail was generated in perspective: with t = 0 at the notch (930, 128) and 1 at the bottom
// edge, its centre is x = 930 + t·(−150 + 170·sin(1.7πt)) and its half-width 0.8 + 78·t^1.1.
// Width and sideways swing both grow linearly with distance from the horizon. Each edge is sampled
// at 49 points and joined with Catmull-Rom curves, so it reads as a smooth road, not a polyline.
//
// `variant="line"` draws the same valley as line art for the footer of every other page: the
// ridges as hairlines, the sun faint (as on the Book's chapter trail) and the path in the accent,
// cropped to the band around the notch and scaled to the column instead of bleeding out of it.
interface Props {
	variant?: "painted" | "line";
}
const { variant = "painted" } = Astro.props;

const FAR =
	"M0 100 C 320 86, 690 94, 860 118 C 895 123, 918 127, 930 128 C 946 126, 985 116, 1080 106 C 1240 92, 1380 92, 1440 90";
const MID = "M0 158 C 260 124, 520 126, 760 148 C 860 157, 960 150, 1100 138 C 1260 124, 1380 128, 1440 132";
const FRONT = "M0 214 C 300 198, 500 206, 640 226 C 700 236, 860 238, 1000 222 C 1150 206, 1320 208, 1440 214";
// Closes a ridge down to the bottom edge, so it hides what is behind it (the sun's lower half).
const BASE = "L1440 244 L0 244 Z";
const TRAIL =
