---
import { type PatternSlug, type Point, patternThumb } from "../pattern-thumbs.ts";

interface Props {
	slug: PatternSlug;
}

const W = 160;
const H = 56;
const PAD_Y = 4;

const { slug } = Astro.props;
const thumb = patternThumb(slug);

const x = (t: number) => (t / thumb.duration) * W;
const y = (v: number) => H - PAD_Y - (Math.min(v, thumb.yMax) / thumb.yMax) * (H - 2 * PAD_Y);
const points = (pts: readonly Point[]) => pts.map(([t, v]) => `${x(t).toFixed(1)},${y(v).toFixed(1)}`).join(" ");
---

<svg class="pattern-thumb" viewBox={`0 0 ${W} ${H}`} width="100%" aria-hidden="true" role="presentation" preserveAspectRatio="none">
	{thumb.badPhases.map((p) => <rect x={x(p.from).toFixed(1)} y="0" width={(x(p.to) - x(p.from)).toFixed(1)} height={H} fill="var(--v-fail)" fill-opacity="0.12" />)}
	<polyline points={points(thumb.without)} fill="none" stroke="var(--v-without, var(--sl-color-gray-3))" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
	<polyline points={points(thumb.with)} fill="none" stroke="var(--v-first)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
</svg>

<style>
	.pattern-thumb {
		display: block;
		height: auto;
		aspect-ratio: 160 / 56;
	}
</style>
