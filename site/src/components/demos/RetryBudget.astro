---
// Why a retry budget saves a slow host
// The simulation is in site/demos/models/, the player and drawing helpers in site/demos/engine/.
---

<div class="demo not-content">
  <p class="lede">Two clients send the same 80 requests per second to the same host. At 8 s the host slows down and can serve only 60 per second. At 24 s it is fixed.</p>
  <p class="lede">Both clients retry failed requests up to 3 times. Only the right one has a retry budget. Press Play: the page slows down at key moments and says what happened.</p>

  <div class="controls">
    <button id="play" type="button">Play</button>
    <button id="replay" class="ghost" type="button">Replay</button>
    <label class="field" for="maxRetries">Max retries <input id="maxRetries" type="range" min="1" max="5" step="1" value="3"> <output id="maxRetriesOut">3</output></label>
    <label class="field" for="ratio">Budget ratio <input id="ratio" type="range" min="0.05" max="0.5" step="0.05" value="0.1"> <output id="ratioOut">0.10</output></label>
    <label class="field" for="speed">Speed <select id="speed"></select></label>
    <label class="field" for="guided"><input id="guided" type="checkbox" checked> Slow down at key moments</label>
    <span class="clock" id="clock">t = 0.0 s</span>
  </div>

  <div class="timeline" id="timeline"></div>
  <p class="caption" id="caption" aria-live="polite"></p>

  <div class="legend">
    <span><i class="mark" data-state="first"></i>First attempt</span>
    <span><i class="mark" data-state="retry"></i>Retry</span>
    <span><i class="mark" data-state="ok"></i>Served</span>
    <span><i class="mark" data-state="fail"></i>Timed out / failed</span>
    <span><i class="mark" data-state="refused"></i>Retry refused by budget (fails fast)</span>
  </div>

  <div class="lanes">
    <article class="panel lane">
      <header><h2>Retries, no budget</h2><span class="cfg" id="cfgA">retry: &#123; maxRetries: 3 &#125;</span></header>
      <canvas id="laneA" aria-label="Animation: client without a retry budget"></canvas>
      <div class="stats">
        <div class="stat"><span class="v" id="aLoad">0</span><span class="k">attempts/s hitting the host</span></div>
        <div class="stat"><span class="v" id="aX">1.00×</span><span class="k">times normal load</span></div>
        <div class="stat"><span class="v" id="aOk">0</span><span class="k">of 80 req/s succeed</span></div>
        <div class="stat"><span class="v" id="aRet">0</span><span class="k">retries sent/s</span></div>
      </div>
    </article>
    <article class="panel lane">
      <header><h2>Retries + retry budget</h2><span class="cfg" id="cfgB">retryBudget: &#123; ratio: 0.1, windowMs: 1000 &#125;</span></header>
      <canvas id="laneB" aria-label="Animation: client with a retry budget"></canvas>
      <div class="stats">
        <div class="stat"><span class="v" id="bLoad">0</span><span class="k">attempts/s hitting the host</span></div>
        <div class="stat"><span class="v" id="bX">1.00×</span><span class="k">times normal load</span></div>
        <div class="stat"><span class="v" id="bOk">0</span><span class="k">of 80 req/s succeed</span></div>
        <div class="stat"><span class="v" id="bRef">0</span><span class="k">retries refused/s</span></div>
      </div>
    </article>
  </div>

  <div class="charts">
    <div class="panel chart">
      <h3>Load on the host (attempts per second, over the last 1 s)</h3>
      <canvas id="chartLoad" aria-label="Chart of host load over time"></canvas>
      <p>The dashed line is what the host can serve. Above it, the host falls behind and requests time out.</p>
    </div>
    <div class="panel chart">
      <h3>Requests that succeed (per second, out of 80)</h3>
      <canvas id="chartOk" aria-label="Chart of successful requests over time"></canvas>
      <p>The budget gets more requests through during the outage, and all of them once the host is fixed.</p>
    </div>
  </div>

  <div class="explain">
    <section>
      <h2>Why plain retries never let go</h2>
      <ol>
        <li>The host slows down. Requests wait longer than the client's timeout, so the client counts them as failures.</li>
        <li>Every failure comes back as a retry, up to 3 times. One request can become 4 attempts.</li>
        <li>The host now gets about 3.6× its normal traffic. It spends time on requests whose clients already gave up, so it serves even fewer.</li>
        <li>Fewer served means more failures, which means more retries. The loop feeds itself.</li>
      </ol>
      <p>Look at the left lane after the host is fixed. It can serve 120/s again, but the retries keep sending it more than that, so it stays down.</p>
      <p>This is a <strong>metastable failure</strong>. The original cause is gone, and the retries alone keep the outage going.</p>
    </section>
    <section>
      <h2>What the budget changes</h2>
      <p>The budget doesn't look at whether a single request deserves a retry. It looks at the whole partition: retries may add at most <code>ratio</code> on top of the first attempts seen in the last <code>windowMs</code>.</p>
      <div class="formula">allowed = max(minRetriesPerSec × windowMs/1000,
              ratio × firstAttemptsInWindow)
retry allowed only while  retriesInWindow &lt; allowed</div>
      <p>With <code>ratio: 0.1</code>, the host gets at most about 1.1× its normal load over any 1 s window, however bad things get.</p>
      <p>A refused retry fails right away with its last error, so the caller hears about it quickly instead of waiting.</p>
      <p>As soon as the host is fixed, load is already below capacity and everything succeeds.</p>
      <p class="note">Try moving the sliders: with 1 max retry, even the left lane recovers. With a budget ratio of 0.5, the right lane carries more load during the outage.</p>
    </section>
    <section>
      <h2>In Vereda</h2>
      <div class="formula">HttpClient.create(&#123;
  timeout: &#123; attemptMs: 1_000 &#125;,
  retry: &#123; maxRetries: 3 &#125;,
  retryBudget: &#123;
    ratio: 0.1,
    windowMs: 1_000,
    minRetriesPerSec: 1,
  &#125;,
&#125;)</div>
      <p class="note">This page follows the logic of <code>tryWithdraw</code> in <code>src/queue/retry-budget.ts</code>. A test, <code>test/demos/retry-budget.parity.test.ts</code>, checks the budget rule on this page against the real <code>RetryBudget</code>.</p>
      <p class="note">The host is a model. Its capacity, overload collapse, random failures and retry delay are invented for the demo, and no test checks them.</p>
      <p class="note">In the model, the host's throughput drops as it gets overloaded, down to 30% at 2.2× its capacity. 5% of requests fail at random, and retries wait 0.3 s before they go out.</p>
      <p class="note">The model has no client timeout: a request the overloaded host doesn't serve counts as failed, standing in for one that timed out.</p>
      <p class="note">Load is shown over the last second, the window the budget counts in. Tick by tick, admitted retries arrive in bursts: a window's allowance goes out as soon as room frees up.</p>
      <p class="note">Here <code>minRetriesPerSec</code> is 1 instead of Vereda's default of 10, so the ratio is what you see working.</p>
    </section>
  </div>
</div>

<script>
	// @ts-nocheck: ported from the standalone demo pages, plain JavaScript like engine/*.js
	// and models/*.js (excluded in tsconfig.json). Their behavior is pinned by test/demos/.
import { LANE_SHAPES, legend, mix, playedLine, roundRect, sizeCanvas, stateMark, timeAxes, valueAt } from "../../../demos/engine/draw.js";
import { mountDemo } from "../../../demos/engine/player.js";
import { DT, END, RATE, simulate } from "../../../demos/models/retry-budget.js";

// ---- Drawing --------------------------------------------------------------
const $ = (id) => document.getElementById(id);
const DOT = 1; // attempts per drawn dot
// Sim seconds a dot spends travelling to the host (half of it for a refused retry). Shorter
// than the model's 0.3 s retry delay minus a tick, so a failure is always drawn before its
// retry leaves.
const GO = 0.18;
const OK_T = 0.5;
const FAIL_T = 0.8;
const DROP_T = 1.0;
const AFTER = Math.max(OK_T, FAIL_T, DROP_T) + 0.1; // how long a dot stays after it arrives

/** Seeded hash to a number in [0, 1). The same inputs always give the same output. */
function hash(a, b, c) {
  let h = Math.imul(a ^ 0x9e3779b9, 0x85ebca6b) ^ Math.imul(b + 0x7f4a7c15, 0xc2b2ae35) ^ Math.imul(c + 1, 0x27d4eb2f);
  h ^= h >>> 15;
  h = Math.imul(h, 0x2c1b3c6d);
  h ^= h >>> 12;
  h = Math.imul(h, 0x297a2d39);
  h ^= h >>> 15;
  return (h >>> 0) / 4294967296;
}

function drawLane(canvas, lane, simT, col, laneId, withBudget) {
  const { ctx, w, h } = sizeCanvas(canvas);
  const clientR = 74;
  const hostL = w - 104;
  const gateX = (clientR + hostL) / 2;
  const cy = h / 2 - 8;
  const load = valueAt(lane.series.load, simT);
  // Capacity is setup: shown from the start, also during the pre-roll before 0 s.
  const C = valueAt(lane.series.capacity, Math.max(0, simT));

  // client box
  ctx.fillStyle = col.bg;
  ctx.strokeStyle = col.line;
  ctx.lineWidth = 1;
  roundRect(ctx, 8, cy - 50, clientR - 14, 100, 8);
  ctx.fill();
  ctx.stroke();
  ctx.fillStyle = col.ink;
  ctx.font = col.strong;
  ctx.textAlign = "center";
  ctx.fillText("client", 8 + (clientR - 14) / 2, cy + 4);

  // budget gate
  if (withBudget) {
    ctx.strokeStyle = col.muted;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(gateX, cy - 56);
    ctx.lineTo(gateX, cy + 56);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = col.muted;
    ctx.font = col.strong;
    ctx.fillText("budget", gateX, cy - 62);
  }

  // host box with load gauge
  const hostW = 96;
  const hy = cy - 62;
  const hh = 124;
  const over = load > C;
  ctx.fillStyle = over ? mix(col.fail, col.surface, 0.18) : col.bg;
  ctx.strokeStyle = over ? col.fail : col.line;
  roundRect(ctx, hostL, hy, hostW, hh, 8);
  ctx.fill();
  ctx.stroke();
  ctx.fillStyle = col.ink;
  ctx.font = col.strong;
  ctx.fillText("host", hostL + 34, hy + 18);
  const MAX = 400;
  const gx = hostL + hostW - 26;
  const gy = hy + 10;
  const gh = hh - 20;
  const gw = 14;
  ctx.fillStyle = col.surface;
  ctx.strokeStyle = col.line;
  ctx.fillRect(gx, gy, gw, gh);
  ctx.strokeRect(gx, gy, gw, gh);
  const fillH = Math.min(1, load / MAX) * gh;
  ctx.fillStyle = over ? col.fail : col.ok;
  ctx.fillRect(gx, gy + gh - fillH, gw, fillH);
  const capY = gy + gh - (C / MAX) * gh;
  ctx.strokeStyle = col.cap;
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(gx - 6, capY);
  ctx.lineTo(gx + gw + 2, capY);
  ctx.stroke();
  ctx.lineWidth = 1;
  ctx.fillStyle = col.muted;
  ctx.font = col.label;
  ctx.textAlign = "right";
  ctx.fillText(`cap ${C}`, gx - 8, capY + 3);
  ctx.textAlign = "left";
  ctx.fillStyle = over ? col.fail : col.ink;
  ctx.font = col.big;
  ctx.fillText(`${Math.round(load)}/s`, hostL + 10, hy + hh - 14);

  // Dots. Each tick's series values say how many dots of each kind reach the host (or, for a
  // refused retry, the budget gate) in it: a dot is timed to ARRIVE on the tick the model counts
  // it, and its fate is that tick's failure rate, so a failure is drawn before the retry it
  // causes leaves. A seeded hash fixes arrival times, heights and fates, and a dot's place is a
  // function of simT, so pause, replay and speed all agree. Traffic was already flowing before
  // t = 0, so the first second's dots are in flight from the start.
  const startX = clientR;
  const endX = hostL - 4;
  const rates = [RATE, null, null];
  // Nothing arrives after the scenario ends; the player runs on until the last dots fade.
  const k1 = Math.floor(Math.min(simT + GO, END) / DT);
  const k0 = Math.max(0, Math.floor((simT - AFTER) / DT));
  for (let k = k0; k <= k1; k++) {
    rates[1] = lane.series.retries[k]?.[1] ?? 0;
    rates[2] = lane.series.refused[k]?.[1] ?? 0;
    for (let kind = 0; kind < 3; kind++) {
      const seed = laneId * 8 + kind;
      const count = Math.floor((rates[kind] * DT) / DOT + hash(seed, k, 0));
      for (let i = 0; i < count; i++) {
        const arrival = (k + hash(seed, k, i * 4 + 1)) * DT;
        const age = simT - (arrival - (kind === 2 ? GO / 2 : GO));
        if (age < 0) continue;
        const y = cy + (hash(seed, k, i * 4 + 2) - 0.5) * 70;
        let x;
        let yy = y;
        let r = 3.2;
        let state = kind === 0 ? "first" : "retry";
        let alpha = 1;
        if (kind === 2) {
          const go = age / (GO / 2);
          if (go < 1) x = startX + (gateX - startX) * go;
          else {
            const d = (age - GO / 2) / DROP_T;
            if (d >= 1) continue;
            x = gateX + 6 * d;
            yy = y + 80 * d * d;
            state = "refused";
            alpha = 1 - d * 0.8;
          }
        } else if (age < GO) {
          x = startX + (endX - startX) * (age / GO);
        } else {
          const failed = hash(seed, k, i * 4 + 3) < valueAt(lane.series.failP, arrival);
          if (failed) {
            const d = (age - GO) / FAIL_T;
            if (d >= 1) continue;
            x = endX - 40 * d;
            yy = y + 14 * d * d;
            state = "fail";
            alpha = 1 - d;
          } else {
            const d = (age - GO) / OK_T;
            if (d >= 1) continue;
            x = endX + 6;
            r = 3 + 6 * d;
            state = "ok";
            alpha = 1 - d;
          }
        }
        stateMark(ctx, state, x, yy, r, col, alpha);
      }
    }
  }
}

function drawChart(trace, simT, col, id, key, yMax, ticks, showCap) {
  const { ctx, w, h } = sizeCanvas($(id));
  const pad = [10, 10, 24, 40];
  const { X, Y } = timeAxes(ctx, { w, h, pad, end: trace.duration, yMax, ticks, phases: trace.phases, col });
  if (showCap) {
    ctx.strokeStyle = col.cap;
    ctx.setLineDash([5, 4]);
    ctx.beginPath();
    trace.lanes.without.series.capacity.forEach(([t, v], i) => {
      if (i) ctx.lineTo(X(t), Y(v));
      else ctx.moveTo(X(t), Y(v));
    });
    ctx.stroke();
    ctx.setLineDash([]);
  }
  playedLine(ctx, trace.lanes.without.series[key], X, Y, col.fail, simT, LANE_SHAPES.without);
  playedLine(ctx, trace.lanes.with.series[key], X, Y, col.first, simT, LANE_SHAPES.with);
  legend(ctx, pad[3] + 6, pad[0] + 12, [["no budget", col.fail, LANE_SHAPES.without], ["with budget", col.first, LANE_SHAPES.with], ...(showCap ? [["- - capacity", col.ink]] : [])], col);
}

function setStat(id, text, cls) {
  const el = $(id);
  const next = `v${cls ? ` ${cls}` : ""}`;
  if (el.textContent !== String(text)) el.textContent = text;
  if (el.className !== next) el.className = next;
}

function render(trace, simT, col) {
  const { without, with: withB } = trace.lanes;
  drawLane($("laneA"), without, simT, col, 0, false);
  drawLane($("laneB"), withB, simT, col, 1, true);
  drawChart(trace, simT, col, "chartLoad", "load", 320, [0, 80, 160, 240, 320], true);
  drawChart(trace, simT, col, "chartOk", "ok", 80, [0, 20, 40, 60, 80], false);
  for (const [p, lane] of [["a", without], ["b", withB]]) {
    const s = lane.series;
    const load = valueAt(s.load, simT);
    const ok = valueAt(s.ok, simT);
    const retries = valueAt(s.retries, simT);
    setStat(`${p}Load`, Math.round(load), load > valueAt(s.capacity, Math.max(0, simT)) ? "bad" : "");
    // Two decimals: healthy traffic is 1.05× (the 5% random failures are retried), which one
    // decimal would round up to the budget's 1.1×.
    setStat(`${p}X`, `${(load / RATE).toFixed(2)}×`, load / RATE > 1.5 ? "bad" : "");
    setStat(`${p}Ok`, Math.round(ok), ok < 60 ? "bad" : "good");
    if (p === "a") setStat("aRet", Math.round(retries), retries > 40 ? "bad" : "");
    else setStat("bRef", Math.round(valueAt(s.refused, simT)), "");
  }
}

// ---- Wiring -----------------------------------------------------------------
function build(o) {
  const trace = simulate(o);
  $("cfgA").textContent = trace.lanes.without.config;
  $("cfgB").textContent = trace.lanes.with.config;
  return trace;
}

const demo = mountDemo({
  build,
  render,
  settle: AFTER, // nothing arrives after the end, and a dot stays at most AFTER once it has
  options: { maxRetries: 3, ratio: 0.1 },
  speed: 2,
});

$("maxRetries").addEventListener("input", (e) => {
  $("maxRetriesOut").textContent = e.target.value;
  demo.rerun({ maxRetries: Number(e.target.value) });
});
$("ratio").addEventListener("input", (e) => {
  const ratio = Number(e.target.value);
  $("ratioOut").textContent = ratio.toFixed(2);
  demo.rerun({ ratio });
});
</script>
