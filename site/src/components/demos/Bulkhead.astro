---
// What a bulkhead does when one service gets slow
// The simulation is in site/demos/models/, the player and drawing helpers in site/demos/engine/.
---

<div class="demo not-content">
  <p class="lede">One client talks to two services. <code>payments</code> is fast. <code>search</code> gets slow at 6 s and is fixed at 20 s. Both clients send the same traffic and share one global limit.</p>
  <p class="lede">Only the right client also gives <code>search</code> its own partition limit. Retries are off here, so each box is one request. Press Play. The page slows down at key moments and says what happened.</p>

  <div class="controls">
    <button id="play" type="button">Play</button>
    <button id="replay" class="ghost" type="button">Replay</button>
    <label class="field" for="slow">Search answers in <input id="slow" type="range" min="1" max="8" step="1" value="4"> <output id="slowOut">4 s</output></label>
    <label class="field" for="global">Global permits <input id="global" type="range" min="4" max="12" step="1" value="8"> <output id="globalOut">8</output></label>
    <label class="field" for="slots">Search slots <input id="slots" type="range" min="1" max="6" step="1" value="3"> <output id="slotsOut">3</output></label>
    <label class="field" for="speed">Speed <select id="speed"></select></label>
    <label class="field" for="guided"><input id="guided" type="checkbox" checked> Slow down at key moments</label>
    <span class="clock" id="clock">t = 0.0 s</span>
  </div>

  <div class="timeline" id="timeline" role="img" aria-label="Scenario timeline"></div>
  <p class="caption" id="caption" aria-live="polite"></p>

  <div class="legend">
    <span><i class="dot" style="background:var(--first)"></i>payments request</span>
    <span><i class="dot" style="background:var(--retry)"></i>search request</span>
    <span><i class="dot ring" style="border-color:var(--fail)"></i>Rejected with <code>QueueFullError</code></span>
  </div>

  <div class="lanes">
    <article class="panel lane">
      <header><h2>Global limit only</h2><span class="cfg" id="cfgA">concurrency: 8, maxQueueSize: 20</span></header>
      <canvas id="laneA" aria-label="Animation: client with only the global limit"></canvas>
      <div class="stats">
        <div class="stat"><span class="v" id="aWait">0</span><span class="k">payments waiting right now</span></div>
        <div class="stat"><span class="v" id="aAvg">0 ms</span><span class="k">payments average wait, last 2 s</span></div>
        <div class="stat"><span class="v" id="aRej">0</span><span class="k">payments rejected</span></div>
        <div class="stat"><span class="v" id="aSrch">0</span><span class="k">search rejected</span></div>
      </div>
    </article>
    <article class="panel lane">
      <header><h2>With a search partition limit</h2><span class="cfg" id="cfgB">search: concurrency 3, limitFirstAttempts</span></header>
      <canvas id="laneB" aria-label="Animation: client with a partition limit for search"></canvas>
      <div class="stats">
        <div class="stat"><span class="v" id="bWait">0</span><span class="k">payments waiting right now</span></div>
        <div class="stat"><span class="v" id="bAvg">0 ms</span><span class="k">payments average wait, last 2 s</span></div>
        <div class="stat"><span class="v" id="bRej">0</span><span class="k">payments rejected</span></div>
        <div class="stat"><span class="v" id="bSrch">0</span><span class="k">search rejected</span></div>
      </div>
    </article>
  </div>

  <div class="charts">
    <div class="panel chart">
      <h3>How long each payments request waited to start</h3>
      <canvas id="chartWait" aria-label="Scatter chart of payments wait time per request"></canvas>
      <p>Each point is one payments request, and it is placed where the request started. Dots on the top line were rejected by a full queue. Waiting here means waiting for a global permit.</p>
    </div>
    <div class="panel chart">
      <h3>Global permits held by search</h3>
      <canvas id="chartSlots" aria-label="Chart of global permits held by search over time"></canvas>
      <p>The dashed line is the global limit. Without a partition limit, search can take every permit. With one, it stops at its own number of slots.</p>
    </div>
  </div>

  <div class="explain">
    <section>
      <h2>What the bulkhead gives you</h2>
      <ol>
        <li><strong>Search cannot take every permit.</strong> With 3 search slots and 8 global permits, search holds at most 3 permits. Payments always has the other 5.</li>
        <li><strong>The overflow waits in search's own queue.</strong> A search request in that queue holds no global permit. It does not block the global queue that payments uses.</li>
        <li><strong>Only search sees the errors.</strong> When the search queue is full, new search requests fail at once with <code>QueueFullError</code> and <code>scope: "partition"</code>. Payments keeps working.</li>
      </ol>
    </section>
    <section>
      <h2>What it costs</h2>
      <ul>
        <li>Search gets worse. Its requests wait longer and more of them fail. The bulkhead moves the pain to the slow service. It does not fix it.</li>
        <li>It counts requests that run at the same time. It does not limit requests per second. A rate limit does that.</li>
        <li>Queued requests have no wait limit of their own. Set <code>timeout.totalMs</code> if you want them to give up.</li>
        <li>By default the bulkhead skips first attempts. Without <code>limitFirstAttempts: true</code>, only the global limit applies, as in the left lane. The partition limit always applies to retries.</li>
      </ul>
      <p class="note">What is not limited: payments has no limit of its own here, so it can still use every free global permit.</p>
      <p class="note">If many partitions get slow at once, they can still fill the global queue together. A partition limit only helps when it is smaller than the global limit.</p>
    </section>
    <section>
      <h2>In Vereda</h2>
      <div class="formula">HttpClient.create(&#123;
  timeout: &#123; attemptMs: 6_000 &#125;,
  concurrency: 8,      // global permits
  maxQueueSize: 20,    // global queue
  partitions: &#123;
    search: &#123;
      concurrency: 3,        // slots
      maxQueueSize: 10,      // own queue
      limitFirstAttempts: true,
    &#125;,
  &#125;,
&#125;)</div>
      <p class="note">There are two limits. The global semaphore (<code>src/queue/semaphore.ts</code>) counts every attempt in the client.</p>
      <p class="note">The partition bulkhead (<code>src/queue/bulkhead.ts</code>) counts attempts in one partition. A partition is the host unless you set <code>partition</code> on the request.</p>
      <p class="note">With <code>limitFirstAttempts: true</code>, an attempt takes a partition slot first and then a global permit (<code>src/core/client.ts</code>). The slot stays taken while it waits for the permit.</p>
      <p class="note">A full queue gives <code>QueueFullError</code>, with <code>scope: "global"</code> or <code>"partition"</code>. Retries in <code>src/queue/retry.ts</code> always use both limits.</p>
      <p class="note">Defaults: 50 permits and 100 queued globally, 5 slots and 100 queued per partition. Here the numbers are smaller so the effect is easy to see.</p>
      <p class="note">A test (<code>test/demos/bulkhead.parity.test.ts</code>) runs this page's model against the real <code>HttpClient</code>, request by request, so the page has to change when the library does.</p>
    </section>
  </div>
</div>

<style is:global>
	/* Page-specific: the legend ring for rejected requests. */
	.demo .dot.ring { background: transparent; border: 2px solid var(--fail); }
</style>

<script>
	// @ts-nocheck: ported from the standalone demo pages, plain JavaScript like engine/*.js
	// and models/*.js (excluded in tsconfig.json). Their behavior is pinned by test/demos/.
import { dot, legend, playedLine, roundRect, sizeCanvas, timeAxes, valueAt } from "../../../demos/engine/draw.js";
import { mountDemo } from "../../../demos/engine/player.js";

import { GQ, PQ, simulate } from "../../../demos/models/bulkhead.js";

// ---- Drawing --------------------------------------------------------------
const $ = (id) => document.getElementById(id);
const partColor = (a, col) => (a.partition === "payments" ? col.first : col.retry);

// What each request is doing at time s.
// pq: waiting for a search slot, gq: waiting for a global permit, run: holding a permit.
function snapshot(attempts, s) {
  const pq = [];
  const gq = [];
  const run = [];
  const slots = [];
  const flash = [];
  for (const a of attempts) {
    if (a.sent > s) break;
    if (a.outcome === "rejected") {
      if (s - a.end < 0.8) flash.push(a);
      continue;
    }
    const pStart = a.slot ?? a.sent;
    if (s < pStart) pq.push(a);
    else if (s < a.start) gq.push(a);
    else if (s < a.end) run.push(a);
    if (a.slot !== undefined && a.slot <= s && s < a.end) slots.push(a);
  }
  const byStart = (x, y) => (x.slot ?? x.sent) - (y.slot ?? y.sent);
  pq.sort((x, y) => x.sent - y.sent);
  gq.sort(byStart);
  run.sort((x, y) => x.start - y.start);
  return { pq, gq, run, slots, flash };
}

function boxes(ctx, x0, y, n, size, gap, items, col) {
  for (let i = 0; i < n; i++) {
    const x = x0 + i * (size + gap);
    const it = items[i];
    roundRect(ctx, x, y, size, size, 3);
    if (it) {
      ctx.fillStyle = partColor(it, col);
      ctx.fill();
      if (it.outcome === "timeout") {
        ctx.strokeStyle = col.fail;
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.lineWidth = 1;
      }
    } else {
      ctx.strokeStyle = col.line;
      ctx.lineWidth = 1;
      ctx.stroke();
    }
  }
}

function drawLane(canvas, lane, simT, col, bulk) {
  const { ctx, w, h } = sizeCanvas(canvas);
  const G = valueAt(lane.series.permitCap, 0);
  const C = valueAt(lane.series.slotCap, 0);
  const sn = snapshot(lane.attempts, simT);
  const pad = 8;
  const inner = w - 2 * pad;
  ctx.textAlign = "left";
  ctx.font = col.label;
  const label = (t, y, c) => {
    ctx.fillStyle = c || col.muted;
    ctx.fillText(t, pad, y);
  };

  // global permits
  const gap = 4;
  const bs = Math.max(10, Math.min(26, (inner - (G - 1) * gap) / G));
  label(`global permits: ${sn.run.length}/${G} in use`, 14, sn.run.length >= G ? col.fail : col.muted);
  boxes(ctx, pad, 22, G, bs, gap, sn.run, col);
  const sHold = sn.run.filter((a) => a.partition === "search").length;

  // global queue
  const qs = Math.max(6, Math.min(16, inner / GQ - 2));
  label(`global queue: ${sn.gq.length}/${GQ}`, 82, sn.gq.length >= GQ ? col.fail : col.muted);
  boxes(ctx, pad, 90, GQ, qs, 2, sn.gq, col);

  if (bulk) {
    const ss = Math.max(10, Math.min(22, (inner - (C - 1) * gap) / C));
    const heldSlots = sn.slots.length;
    label(`search slots: ${heldSlots}/${C}`, 130, heldSlots >= C ? col.retry : col.muted);
    boxes(ctx, pad, 138, C, ss, gap, sn.slots, col);
    const ps = Math.max(6, Math.min(16, inner / PQ - 2));
    label(`search queue: ${sn.pq.length}/${PQ}`, 178, sn.pq.length >= PQ ? col.fail : col.muted);
    boxes(ctx, pad, 186, PQ, ps, 2, sn.pq, col);
  } else {
    label("no search limit", 130);
    ctx.fillStyle = sHold >= G ? col.fail : col.ink;
    ctx.font = col.strong;
    ctx.fillText(`search holds ${sHold} of ${G} permits`, pad, 150);
    ctx.fillStyle = col.muted;
    ctx.font = col.label;
    ctx.fillText("payments waits in the same queue", pad, 170);
  }

  // rejected requests, shown for a moment
  label("QueueFullError", h - 8);
  for (const a of sn.flash) {
    const age = (simT - a.end) / 0.8;
    const x = pad + 110 + (((a.request * 37) % 100) / 100) * Math.max(10, inner - 124);
    dot(ctx, x, h - 12, 3.4, partColor(a, col), 1 - age * 0.7);
    ctx.globalAlpha = 1 - age * 0.7;
    ctx.strokeStyle = col.fail;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(x, h - 12, 6.5, 0, Math.PI * 2);
    ctx.stroke();
    ctx.lineWidth = 1;
    ctx.globalAlpha = 1;
  }
}

const waitMaxOf = (trace) => {
  let m = 0;
  for (const l of [trace.lanes.without, trace.lanes.with]) {
    for (const a of l.attempts) if (a.partition === "payments" && a.start !== null) m = Math.max(m, a.start - a.sent);
  }
  return Math.max(2, Math.ceil(m / 2) * 2);
};

function drawWait(trace, simT, col) {
  const { ctx, w, h } = sizeCanvas($("chartWait"));
  const waitMax = waitMaxOf(trace);
  const pad = [22, 10, 22, 44];
  const { X, Y } = timeAxes(ctx, {
    w,
    h,
    pad,
    end: trace.duration,
    yMax: waitMax,
    ticks: [0, waitMax / 3, (2 * waitMax) / 3, waitMax],
    fmt: (v) => `${+v.toFixed(1)}s`,
    phases: trace.phases,
    col,
  });
  const pts = (attempts, color, dy) => {
    for (const a of attempts) {
      if (a.partition !== "payments") continue;
      const rej = a.outcome === "rejected";
      const x = rej ? a.end : a.start;
      const alpha = x <= simT ? 0.9 : 0.12;
      dot(ctx, X(x), Y(rej ? waitMax : a.start - a.sent) + dy, rej ? 2 : 2.3, color, alpha);
      if (rej) {
        ctx.globalAlpha = alpha;
        ctx.strokeStyle = color;
        ctx.beginPath();
        ctx.arc(X(x), Y(waitMax) + dy, 4.5, 0, Math.PI * 2);
        ctx.stroke();
        ctx.globalAlpha = 1;
      }
    }
  };
  pts(trace.lanes.without.attempts, col.fail, 0);
  pts(trace.lanes.with.attempts, col.first, 3);
  legend(ctx, pad[3] + 6, 12, [["global only", col.fail], ["with search limit", col.first]], col);
}

function drawSlots(trace, simT, col) {
  const { ctx, w, h } = sizeCanvas($("chartSlots"));
  const yMax = valueAt(trace.lanes.with.series.permitCap, 0);
  const pad = [22, 10, 22, 30];
  const { X, Y } = timeAxes(ctx, { w, h, pad, end: trace.duration, yMax, ticks: [0, Math.round(yMax / 2), yMax], phases: trace.phases, col });
  ctx.strokeStyle = col.cap;
  ctx.lineWidth = 1;
  ctx.setLineDash([5, 4]);
  ctx.beginPath();
  ctx.moveTo(pad[3], Y(yMax));
  ctx.lineTo(w - pad[1], Y(yMax));
  ctx.stroke();
  ctx.setLineDash([]);
  playedLine(ctx, trace.lanes.without.series.permitsHeld, X, Y, col.fail, simT);
  playedLine(ctx, trace.lanes.with.series.permitsHeld, X, Y, col.first, simT);
  legend(ctx, pad[3] + 6, 12, [["global only", col.fail], ["with search limit", col.first]], col);
}

function setStat(id, text, cls) {
  const el = $(id);
  const next = `v${cls ? ` ${cls}` : ""}`;
  if (el.textContent !== String(text)) el.textContent = text;
  if (el.className !== next) el.className = next;
}
function laneStats(attempts, simT) {
  let waiting = 0;
  let sum = 0;
  let n = 0;
  let payRej = 0;
  let srchRej = 0;
  for (const a of attempts) {
    if (a.sent > simT) break;
    if (a.outcome === "rejected") {
      if (a.end <= simT) {
        if (a.partition === "payments") payRej++;
        else srchRej++;
      }
      continue;
    }
    if (a.partition !== "payments") continue;
    if (simT < a.start) waiting++;
    else if (a.start > simT - 2) {
      sum += a.start - a.sent;
      n++;
    }
  }
  return { waiting, avg: n ? (sum / n) * 1000 : 0, payRej, srchRej };
}

function render(trace, simT, col) {
  const { without, with: withB } = trace.lanes;
  drawLane($("laneA"), without, simT, col, false);
  drawLane($("laneB"), withB, simT, col, true);
  drawWait(trace, simT, col);
  drawSlots(trace, simT, col);
  for (const [p, l] of [["a", without], ["b", withB]]) {
    const s = laneStats(l.attempts, simT);
    setStat(`${p}Wait`, s.waiting, s.waiting > 3 ? "bad" : "");
    setStat(`${p}Avg`, `${Math.round(s.avg)} ms`, s.avg > 400 ? "bad" : "");
    setStat(`${p}Rej`, s.payRej, s.payRej ? "bad" : "good");
    setStat(`${p}Srch`, s.srchRej, "");
  }
}

// ---- Wiring -----------------------------------------------------------------
function build(o) {
  const trace = simulate(o);
  $("cfgA").textContent = trace.lanes.without.config;
  $("cfgB").textContent = trace.lanes.with.config;
  return trace;
}

const demo = mountDemo({
  build,
  render,
  options: { slow: 4, G: 8, C: 3 },
  speed: 0.5,
});

$("slow").addEventListener("input", (e) => {
  $("slowOut").textContent = `${e.target.value} s`;
  demo.rerun({ slow: Number(e.target.value) });
});
$("global").addEventListener("input", (e) => {
  $("globalOut").textContent = e.target.value;
  demo.rerun({ G: Number(e.target.value) });
});
$("slots").addEventListener("input", (e) => {
  $("slotsOut").textContent = e.target.value;
  demo.rerun({ C: Number(e.target.value) });
});
</script>
