---
import { Code } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Horizon from "../components/Horizon.astro";
import { PATTERNS } from "../patterns.ts";

// The README's quickstart, word for word.
const quickstart = `import { HttpClient } from "@vereda/http";

const api = HttpClient.create({
  baseUrl: "https://api.example.com",
  timeout: { attemptMs: 5_000 },
});

const result = await api.get("/users/42").toPromise(); // never rejects

if (result.success) {
  const user = await result.raw.json();
} else {
  console.error(result.error.kind, result.error.message); // a typed error
}`;

const code = (s: string) => s.replaceAll(/`([^`]+)`/g, "<code>$1</code>");
---

<StarlightPage
	frontmatter={{
		title: "Make fetch resilient",
		description:
			"Retries, backoff, timeouts, per-host isolation and circuit breaking for fetch on Node.js, Bun and Cloudflare Workers.",
		template: "splash",
	}}
	hasSidebar={false}
>
	<section class="hero">
		<div class="pitch">
			<p class="eyebrow">@vereda/http</p>
			<h1>Make <code>fetch</code> resilient.</h1>
			<p class="lede">
				Retries, backoff, timeouts, per-host isolation and circuit breaking for <code>fetch</code> on Node.js, Bun and
				Cloudflare Workers, with typed results instead of thrown errors. Zero runtime dependencies.
			</p>
			<pre class="install"><code>npm install @vereda/http</code></pre>
			<div class="actions">
				<a class="primary" href="/guide/requests/">Get started</a>
				<a class="secondary" href="/patterns/">See the patterns</a>
			</div>
		</div>

		<figure class="storm" aria-labelledby="storm-caption">
			<div class="storm-head">
				<span class="storm-title">A host slows down at 8 s</span>
				<span class="storm-side">
					<span id="storm-clock">t = 0 s</span>
					<button type="button" class="storm-toggle" id="storm-toggle" hidden>Pause</button>
				</span>
			</div>
			<canvas id="storm" role="img" aria-label="Load on a slow host over 40 seconds: plain retries climb to over 3 times normal load and stay there after the host is fixed; with a retry budget the load stays near normal."></canvas>
			<div class="storm-stats">
				<div><span class="v fail" id="storm-a">1.0×</span><span class="k">load, plain retries</span></div>
				<div><span class="v first" id="storm-b">1.0×</span><span class="k">load, with a retry budget</span></div>
			</div>
			<figcaption id="storm-caption">
				Both clients retry up to 3 times. Without a budget, retries keep the host overloaded even after it is fixed at 24 s.{" "}
				<a href="/patterns/retry-budget/">Play with it →</a>
			</figcaption>
		</figure>
	</section>

	<Horizon />

	<section class="band first">
		<div class="split">
			<div>
				<h2>One call, every safeguard</h2>
				<p>
					A dropped connection, a timeout or a <code>503</code> on that request is retried up to three times with jittered
					exponential backoff before your code sees an error. Each attempt is bounded by <code>attemptMs</code>, and a
					<code>totalMs</code> deadline can bound the whole call.
				</p>
				<p>
					The result is a value, not an exception: <code>result.success</code> or a typed <code>result.error.kind</code>
					you can <code>switch</code> on.
				</p>
				<p><a href="/guide/results-and-errors/">Results and errors →</a></p>
			</div>
			<Code code={quickstart} lang="ts" title="quickstart.ts" wrap />
		</div>
	</section>

	<section class="band">
		<h2>Patterns, animated</h2>
		<p class="sub">Each simulator runs the same traffic with and without the pattern. A test checks every model against the real client.</p>
		<ul class="cards">
			{
				PATTERNS.map((p) => (
					<li>
						<a href={`/patterns/${p.slug}/`}>
							<strong>{p.title}</strong>
							<span set:html={code(p.blurb)} />
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="band">
		<h2>Go deeper</h2>
		<ul class="cards three">
			<li>
				<a href="/guide/requests/"><strong>Guide</strong><span>Requests, results, resilience settings and observability, with examples.</span></a>
			</li>
			<li>
				<a href="/book/"><strong>The Vereda Book</strong><span>How it works inside: one request's life, the invariants, and the bugs that shaped them.</span></a>
			</li>
			<li>
				<a href="/api/"><strong>API reference</strong><span>Every export and option, generated from the source.</span></a>
			</li>
		</ul>
	</section>
</StarlightPage>

<style>
	/* The splash template still prints the page title above the content; the hero has its own. */
	:global(.content-panel:has(> .sl-container > h1#_top)) {
		display: none;
	}
	/* Starlight spaces every sibling in page content; the chart card lays itself out. */
	.storm * + * {
		margin-top: 0;
	}
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		gap: 3rem;
		align-items: center;
		padding-block: 2rem 3rem;
	}
	.eyebrow {
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.hero h1 {
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		line-height: 1.05;
		font-weight: 800;
		margin-top: 0.5rem;
	}
	.hero h1 code {
		font-family: var(--sl-font-mono);
		font-size: 0.85em;
		color: var(--sl-color-accent);
		background: none;
		padding: 0;
	}
	.lede {
		font-size: var(--sl-text-lg);
		color: var(--sl-color-gray-2);
	}
	.install {
		display: inline-block;
		padding: 0.6rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--v-radius-sm);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.actions a {
		padding: 0.6rem 1.2rem;
		border-radius: var(--v-radius-sm);
		font-weight: 600;
		text-decoration: none;
	}
	.actions .primary {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.actions .secondary {
		border: 1px solid var(--sl-color-gray-4);
		color: var(--sl-color-white);
	}

	.storm {
		margin: 0;
		padding: 1rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--v-radius);
		background: var(--v-panel);
	}
	.storm-head {
		display: flex;
		justify-content: space-between;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.storm-title {
		color: var(--sl-color-white);
		font-weight: 600;
	}
	.storm-side {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.storm-toggle {
		padding: 0.1rem 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--v-radius-sm);
		background: none;
		color: var(--sl-color-gray-2);
		font: inherit;
		cursor: pointer;
	}
	.storm-toggle:hover {
		border-color: var(--sl-color-accent);
	}
	#storm {
		width: 100%;
		height: 220px;
		display: block;
		margin-top: 0.5rem;
	}
	.storm-stats {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 0.5rem;
	}
	.storm-stats div {
		display: flex;
		flex-direction: column;
	}
	.storm-stats .v {
		font-size: var(--sl-text-3xl);
		font-weight: 600;
	}
	.storm-stats .k {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.v.fail {
		color: var(--v-fail);
	}
	.v.first {
		color: var(--v-first);
	}
	.storm figcaption {
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}

	.band {
		padding-block: 2.5rem;
		border-top: 1px solid var(--sl-color-gray-6);
	}
	/* The horizon above it already divides the page. */
	.band.first {
		border-top: 0;
	}
	.sub {
		color: var(--sl-color-gray-2);
	}
	.split {
		display: grid;
		/* Wide enough for the quickstart's longest line, so its comments don't wrap. */
		grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.35fr);
		gap: 2.5rem;
		align-items: start;
	}
	.cards {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	.cards li {
		margin: 0;
	}
	.cards a {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		height: 100%;
		padding: 1rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--v-radius);
		text-decoration: none;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.cards a:hover {
		border-color: var(--sl-color-accent);
	}
	.cards strong {
		color: var(--sl-color-white);
		font-size: var(--sl-text-base);
		font-weight: 600;
	}

	@media (max-width: 50rem) {
		.hero,
		.split {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.hero {
			padding-block: 0 2rem;
		}
		.band {
			padding-block: 2rem;
		}
		.cards,
		.cards.three {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	// The retry-budget demo's own model, so the hero shows the numbers its parity test checks.
	import { BAD_FROM, BAD_TO, RATE, simulate } from "../../demos/models/retry-budget.js";

	const canvas = document.getElementById("storm") as HTMLCanvasElement;
	const trace = simulate({ maxRetries: 3, ratio: 0.1 });
	type Series = [number, number][];
	// The model's series are optional in DemoTrace; fail loudly if the ones the hero draws go missing.
	const series = (lane: "without" | "with", key: string): Series => {
		const found = trace.lanes[lane].series?.[key];
		if (!found) throw new Error(`retry-budget trace has no ${lane}.${key} series`);
		return found;
	};
	const without = { load: series("without", "load"), capacity: series("without", "capacity") };
	const withBudget = { load: series("with", "load") };
	const END = trace.duration;
	const SPEED = 2; // sim seconds per real second
	const HOLD = 3; // real seconds the finished chart stays before the loop restarts
	const Y_MAX = 320;

	const css = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
	const at = (series: Series, t: number) => {
		let v = series[0][1];
		for (const [st, sv] of series) {
			if (st > t) break;
			v = sv;
		}
		return v;
	};

	const setText = (id: string, text: string) => {
		const el = document.getElementById(id);
		if (el) el.textContent = text;
	};

	function draw(t: number) {
		const dpr = window.devicePixelRatio || 1;
		const w = canvas.clientWidth;
		const h = canvas.clientHeight;
		if (canvas.width !== Math.round(w * dpr)) canvas.width = Math.round(w * dpr);
		if (canvas.height !== Math.round(h * dpr)) canvas.height = Math.round(h * dpr);
		const ctx = canvas.getContext("2d");
		if (!ctx) return;
		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		ctx.clearRect(0, 0, w, h);
		const pad = { l: 34, r: 14, t: 8, b: 20 };
		const X = (s: number) => pad.l + (s / END) * (w - pad.l - pad.r);
		const Y = (v: number) => pad.t + (1 - Math.min(v, Y_MAX) / Y_MAX) * (h - pad.t - pad.b);
		// gray-3, not gray-4: 12px labels need 4.5:1 on the panel in both themes.
		const muted = css("--sl-color-gray-3");
		const sans = css("--sl-font");

		ctx.fillStyle = css("--v-fail");
		ctx.globalAlpha = 0.14;
		ctx.fillRect(X(BAD_FROM), pad.t, X(BAD_TO) - X(BAD_FROM), h - pad.t - pad.b);
		ctx.globalAlpha = 1;
		ctx.font = `12px ${sans}`;
		ctx.fillStyle = muted;
		ctx.textAlign = "right";
		for (const v of [0, 80, 160, 240, 320]) ctx.fillText(String(v), pad.l - 6, Y(v) + 3);
		ctx.textAlign = "center";
		for (let s = 0; s <= END; s += 8) ctx.fillText(`${s}s`, X(s), h - 5);
		ctx.textAlign = "left";
		ctx.fillText("host slow", X(BAD_FROM) + 4, pad.t + 10);

		ctx.strokeStyle = css("--sl-color-gray-3");
		ctx.setLineDash([4, 4]);
		ctx.beginPath();
		without.capacity.forEach(([s, v], i) => (i ? ctx.lineTo(X(s), Y(v)) : ctx.moveTo(X(s), Y(v))));
		ctx.stroke();
		ctx.setLineDash([]);
		ctx.textAlign = "right";
		ctx.fillStyle = muted;
		ctx.fillText("host capacity", X(END), Y(at(without.capacity, END)) - 5);

		const lines: [Series, string][] = [
			[without.load, css("--v-fail")],
			[withBudget.load, css("--v-first")],
		];
		for (const [series, color] of lines) {
			ctx.strokeStyle = color;
			ctx.lineWidth = 2.5;
			ctx.beginPath();
			let last: [number, number] | undefined;
			for (const [s, v] of series) {
				if (s > t) break;
				if (last) ctx.lineTo(X(s), Y(v));
				else ctx.moveTo(X(s), Y(v));
				last = [X(s), Y(v)];
			}
			ctx.stroke();
			if (last) {
				ctx.fillStyle = color;
				ctx.beginPath();
				ctx.arc(last[0], last[1], 3.5, 0, Math.PI * 2);
				ctx.fill();
			}
		}
		ctx.lineWidth = 1;

		setText("storm-clock", `t = ${Math.floor(t)} s`);
		setText("storm-a", `${(at(without.load, t) / RATE).toFixed(1)}×`);
		setText("storm-b", `${(at(withBudget.load, t) / RATE).toFixed(1)}×`);
	}

	// Motion longer than 5 s needs a way to stop it (WCAG 2.2.2), so the loop has a pause button.
	// Reduced motion gets the finished chart and no button.
	const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
	const loop = END / SPEED + HOLD;
	let paused = still;
	let elapsed = still ? loop : 0; // real seconds into the current loop
	let last: number | undefined;
	const now = () => Math.min(END, elapsed * SPEED);
	const frame = (ts: number) => {
		if (last !== undefined) elapsed = (elapsed + (ts - last) / 1000) % loop;
		last = ts;
		draw(now());
		if (!paused) requestAnimationFrame(frame);
	};

	const toggle = document.getElementById("storm-toggle") as HTMLButtonElement;
	if (still) {
		draw(END);
	} else {
		toggle.hidden = false;
		toggle.addEventListener("click", () => {
			paused = !paused;
			toggle.textContent = paused ? "Play" : "Pause";
			if (!paused) {
				last = undefined;
				requestAnimationFrame(frame);
			}
		});
		requestAnimationFrame(frame);
	}
	// Redraw on theme change while the chart is still.
	new MutationObserver(() => paused && draw(now())).observe(document.documentElement, { attributeFilter: ["data-theme"] });
</script>
