---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { PATTERNS } from "../../patterns.ts";

const code = (s: string) => s.replaceAll(/`([^`]+)`/g, "<code>$1</code>");
---

<StarlightPage
	frontmatter={{
		title: "Patterns, animated",
		description: "Interactive simulators for each resilience pattern in Vereda.",
	}}
>
	<p>Each page runs the same traffic through two clients, one without the pattern and one with it, and plays the result.</p>
	<p>
		The models follow the library's code. A test checks each one against the real <code>HttpClient</code>, so the pages
		change when the library does.
	</p>
	<ul>
		{
			PATTERNS.map((p) => (
				<li>
					<a href={`/patterns/${p.slug}/`}>
						<strong>{p.title}</strong>
					</a>
					: <Fragment set:html={code(p.blurb)} />
				</li>
			))
		}
	</ul>
</StarlightPage>
