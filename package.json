{
	"name": "@vereda/http",
	"version": "1.1.1",
	"description": "Resilient fetch for Node.js, Bun and Cloudflare Workers: retries, backoff, timeouts, per-host bulkheads, circuit breakers, retry budgets and rate limits, with typed results. Zero dependencies.",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/core/index.d.ts",
			"import": "./dist/core/index.js"
		},
		"./middleware": {
			"types": "./dist/middleware/index.d.ts",
			"import": "./dist/middleware/index.js"
		},
		"./zod": {
			"types": "./dist/adapters/zod.d.ts",
			"import": "./dist/adapters/zod.js"
		},
		"./otel": {
			"types": "./dist/otel/index.d.ts",
			"import": "./dist/otel/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"prepublishOnly": "npm run build && npm test",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p examples/tsconfig.json && tsc -p performance/tsconfig.json",
		"example:checkout": "tsx --tsconfig examples/tsconfig.json examples/checkout/index.ts",
		"lint": "biome lint",
		"lint:fix": "biome lint --write",
		"format": "biome format --write",
		"format:check": "biome format",
		"check": "biome check --error-on-warnings",
		"check:fix": "biome check --write",
		"ci": "biome ci --error-on-warnings",
		"docs": "bun run --cwd site build",
		"release:prepare": "tsx scripts/release-prepare.ts",
		"book:check": "tsx scripts/book-check.ts",
		"book:drift": "tsx scripts/book-check.ts drift"
	},
	"keywords": [
		"fetch",
		"http",
		"http-client",
		"retry",
		"backoff",
		"circuit-breaker",
		"bulkhead",
		"rate-limit",
		"rate-limiting",
		"retry-budget",
		"resilience",
		"fault-tolerance",
		"timeout",
		"queue",
		"typescript",
		"bun",
		"cloudflare-workers",
		"opentelemetry"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/riosgabriel/vereda.git"
	},
	"bugs": {
		"url": "https://github.com/riosgabriel/vereda/issues"
	},
	"homepage": "https://vereda.dev",
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@opentelemetry/api": "^1.9.0",
		"zod": "^4.6.5"
	},
	"peerDependenciesMeta": {
		"@opentelemetry/api": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "^2.5.14",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/core": "^2.12.0",
		"@opentelemetry/sdk-metrics": "^2.12.0",
		"@opentelemetry/sdk-trace-base": "^2.12.0",
		"@types/node": "^26.6.2",
		"@vitest/coverage-v8": "5.0.5",
		"fast-check": "^4.10.2",
		"husky": "^9.1.7",
		"publint": "^0.3.24",
		"tsx": "^4.23.15",
		"typescript": "^6.0.0",
		"undici": "^8.12.2",
		"vitest": "^5.0.5",
		"zod": "^4.6.5"
	}
}
