{
	"name": "vereda",
	"version": "1.0.0",
	"description": "A resilient HTTP client with automatic queuing, retries, and bulkhead isolation",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/core/index.d.ts",
			"import": "./dist/core/index.js"
		},
		"./middleware": {
			"types": "./dist/middleware/index.d.ts",
			"import": "./dist/middleware/index.js"
		},
		"./zod": {
			"types": "./dist/adapters/zod.d.ts",
			"import": "./dist/adapters/zod.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"prepublishOnly": "npm run build && npm test",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p examples/tsconfig.json",
		"lint": "biome lint",
		"lint:fix": "biome lint --write",
		"format": "biome format --write",
		"format:check": "biome format",
		"check": "biome check --error-on-warnings",
		"check:fix": "biome check --write",
		"ci": "biome ci --error-on-warnings",
		"docs": "typedoc"
	},
	"keywords": [
		"http",
		"client",
		"queue",
		"retry",
		"bulkhead",
		"resilience"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/riosgabriel/vereda.git"
	},
	"bugs": {
		"url": "https://github.com/riosgabriel/vereda/issues"
	},
	"homepage": "https://github.com/riosgabriel/vereda#readme",
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"zod": "^4.6.4"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "^2.5.13",
		"@types/node": "^26.5.1",
		"@vitest/coverage-v8": "5.0.0",
		"husky": "^9.1.7",
		"publint": "^0.3.24",
		"tsx": "^4.23.13",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.0",
		"vitest": "^5.0.0",
		"zod": "^4.6.4"
	}
}
