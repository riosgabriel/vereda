{
  "name": "vereda",
  "version": "1.0.0",
  "description": "A resilient HTTP client with automatic queuing, retries, and bulkhead isolation",
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware/index.js",
      "types": "./dist/middleware/index.d.ts"
    },
    "./zod": {
      "import": "./dist/adapters/zod.js",
      "types": "./dist/adapters/zod.d.ts"
    }
  },
  "scripts": {
    "build": "bunx tsc",
    "prepare": "npm run build && husky",
    "test": "bunx vitest run",
    "test:watch": "bun vitest",
    "typecheck": "bunx tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "http",
    "client",
    "queue",
    "retry",
    "bulkhead",
    "resilience"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "zod": "^4.5.4"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --check"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.5",
    "zod": "^4.5.4"
  }
}
