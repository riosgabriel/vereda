{
	"name": "vereda",
	"version": "1.0.0",
	"description": "A resilient HTTP client with automatic queuing, retries, and bulkhead isolation",
	"type": "module",
	"main": "./dist/core/index.js",
	"types": "./dist/core/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/core/index.js",
			"types": "./dist/core/index.d.ts"
		},
		"./middleware": {
			"import": "./dist/middleware/index.js",
			"types": "./dist/middleware/index.d.ts"
		},
		"./zod": {
			"import": "./dist/adapters/zod.js",
			"types": "./dist/adapters/zod.d.ts"
		}
	},
	"scripts": {
		"build": "bunx tsc",
		"prepare": "npx tsc && husky",
		"test": "bunx vitest run",
		"test:watch": "bun vitest",
		"typecheck": "bunx tsc --noEmit",
		"biome": "biome",
		"biome:check": "biome check",
		"biome:format": "biome format --write"
	},
	"keywords": [
		"http",
		"client",
		"queue",
		"retry",
		"bulkhead",
		"resilience"
	],
	"license": "MIT",
	"files": [
		"dist"
	],
	"peerDependencies": {
		"zod": "^4.5.4"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},

	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "^26.3.0",
		"husky": "^9.1.7",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5",
		"zod": "^4.5.4"
	}
}
