{
  "name": "relay",
  "version": "1.0.0",
  "description": "A resilient HTTP client with automatic queuing, retries, and bulkhead isolation",
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware/index.js",
      "types": "./dist/middleware/index.d.ts"
    },
    "./zod": {
      "import": "./dist/adapters/zod.js",
      "types": "./dist/adapters/zod.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "http",
    "client",
    "queue",
    "retry",
    "bulkhead",
    "resilience"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.5"
  }
}
